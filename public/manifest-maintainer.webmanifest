{
    "name": "Pattern Maintainer",
    "short_name": "Maintainer",
    "description": "Pattern maintainer and cleaner task app",
    "id": "/maintainer/tasks",
    "start_url": "/maintainer/tasks",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "background_color": "#eef2f7",

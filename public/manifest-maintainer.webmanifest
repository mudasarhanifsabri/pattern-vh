    "orientation": "portrait",
    "categories": ["business", "productivity"],
    "icons": [
        {"src": "/icons/pattern-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
        {"src": "/icons/pattern-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
    ]
}
